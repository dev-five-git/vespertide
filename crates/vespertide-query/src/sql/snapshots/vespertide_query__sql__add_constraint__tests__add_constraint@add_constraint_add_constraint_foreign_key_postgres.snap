UPDATE "users" SET "user_id" = NULL WHERE ("user_id" IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM "users" WHERE "users"."id" = "users"."user_id")
ALTER TABLE "users" ADD CONSTRAINT "fk_users__fk_user" FOREIGN KEY ("user_id") REFERENCES "users" ("id") ON DELETE CASCADE ON UPDATE RESTRICT NOT VALID
ALTER TABLE "users" VALIDATE CONSTRAINT "fk_users__fk_user"
