ALTER TABLE "subscription" ADD COLUMN "tier" integer;
UPDATE "subscription" SET "tier" = CASE WHEN plan_tag = 'legacy::v1' THEN 1 ELSE 2 END::integer;
ALTER TABLE "subscription" ALTER COLUMN "tier" TYPE integer, ALTER COLUMN "tier" SET NOT NULL
