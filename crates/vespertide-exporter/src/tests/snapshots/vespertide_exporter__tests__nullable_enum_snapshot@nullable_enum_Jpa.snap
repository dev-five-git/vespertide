import jakarta.persistence.*;

enum StatusType {
    active,
    inactive;
}

@Entity
@Table(name = "nullable_enum")
public class NullableEnum {

    @Id
    @Column(name = "id")
    private Integer id;

    @Enumerated(EnumType.STRING)
    @Column(name = "status")
    private StatusType status;

    protected NullableEnum() {
    }
}
