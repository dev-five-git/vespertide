export const dual = pgTable("dual", {
  username: text("username").primaryKey(),
});

export const dualRelations = relations(dual, ({ one, many }) => ({
  usernameTripleRel: many(tripleRel, { relationName: "TripleRelUsername" }),
  checkerUsernameTripleRel: many(tripleRel, { relationName: "TripleRelCheckerUsername" }),
  otherUsernameTripleRel: many(tripleRel, { relationName: "TripleRelOtherUsername" }),
}));
