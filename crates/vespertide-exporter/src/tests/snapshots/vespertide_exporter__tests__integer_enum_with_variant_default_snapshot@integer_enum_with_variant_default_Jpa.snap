import jakarta.persistence.*;

enum TaskRunStatus {
    PENDING(0),
    COMPLETED(100);

    private final int value;

    TaskRunStatus(int value) {
        this.value = value;
    }

    public int getValue() {
        return value;
    }
}

@Entity
@Table(name = "task_runs")
public class TaskRuns {

    @Column(name = "id", nullable = false)
    private Integer id;

    @Column(name = "status", nullable = false)
    private Integer status;

    protected TaskRuns() {
    }
}
