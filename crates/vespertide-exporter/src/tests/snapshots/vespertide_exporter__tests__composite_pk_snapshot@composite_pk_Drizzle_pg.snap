export const accounts = pgTable("accounts", {
  id: integer("id").notNull(),
  tenantId: bigint("tenant_id", { mode: "number" }).notNull(),
}, (t) => [
  primaryKey({ name: "accounts_pkey", columns: [t.id, t.tenantId] }),
]);
