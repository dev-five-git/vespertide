---
source: crates/vespertide-exporter/src/tests/mod.rs
expression: rendered
---
model Users {
  id Int @id
  posts Posts[]
  comments Comments[]

  @@map("users")
}

model Posts {
  id Int @id
  user_id Int
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  comments Comments[]

  @@map("posts")
}

model Comments {
  id Int @id
  post_id Int?
  post Posts? @relation(fields: [post_id], references: [id], onDelete: SetDefault, onUpdate: NoAction)
  author_id Int @default(1)
  author Users @relation(fields: [author_id], references: [id], onDelete: SetDefault, onUpdate: Cascade)

  @@map("comments")
}
