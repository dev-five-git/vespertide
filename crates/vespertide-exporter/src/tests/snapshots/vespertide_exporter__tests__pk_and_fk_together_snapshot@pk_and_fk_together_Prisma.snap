---
source: crates/vespertide-exporter/src/tests/mod.rs
expression: rendered
---
model ArticleUser {
  article_id String
  article Article @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_id String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author_order Int @default(1)
  role String @default("contributor")
  is_lead Boolean @default(false)
  created_at DateTime @default(now())

  @@id([article_id, user_id])
  @@index([article_id], map: "ix_article_user__article_id")
  @@index([user_id], map: "ix_article_user__user_id")
  @@map("article_user")
}
