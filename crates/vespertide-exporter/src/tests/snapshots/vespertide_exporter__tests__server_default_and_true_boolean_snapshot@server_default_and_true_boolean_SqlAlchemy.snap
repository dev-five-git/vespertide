from __future__ import annotations

from datetime import datetime

from sqlalchemy import Boolean, DateTime, Float, Integer, Text, text
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class Logs(DeclarativeBase):
    __tablename__ = "logs"

    id: Mapped[int] = mapped_column(Integer, primary_key=True)
    active: Mapped[bool] = mapped_column(Boolean, nullable=False, server_default="true")
    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False, server_default=text("NOW()"))
    score: Mapped[float] = mapped_column(Float, nullable=False, server_default="1.5")
    tag: Mapped[str] = mapped_column(Text, nullable=False, server_default="UNKNOWN_EXPR")
