from __future__ import annotations

from django.db import models


class User(models.Model):
    id = models.UUIDField(primary_key=True)
    articles = models.ManyToManyField("Article", through="ArticleUser", related_name="+")

    class Meta:
        managed = False
        db_table = "user"
