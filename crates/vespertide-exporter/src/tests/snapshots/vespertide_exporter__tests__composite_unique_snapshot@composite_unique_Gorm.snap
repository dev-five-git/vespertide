package models

type CompositeUnique struct {
    ID int32 `gorm:"column:id;primaryKey" json:"id"`
    TenantID int32 `gorm:"column:tenant_id;not null;uniqueIndex:uq_tenant_name" json:"tenant_id"`
    Name string `gorm:"column:name;not null;type:text;uniqueIndex:uq_tenant_name" json:"name"`
