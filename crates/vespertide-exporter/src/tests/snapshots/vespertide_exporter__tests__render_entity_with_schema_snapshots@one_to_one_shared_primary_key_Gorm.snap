package models

import (
	"github.com/google/uuid"
)

type User struct {
	ID      uuid.UUID `gorm:"column:id;primaryKey;type:uuid" json:"id"`
	Profile *Profile  `gorm:"foreignKey:UserID" json:"-"`
}

func (User) TableName() string { return "user" }
