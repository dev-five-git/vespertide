use sea_orm::entity::prelude::*;

#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "no_desc")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
}

vespera::schema_type!(Schema from Model, name = "NoDescSchema");
impl ActiveModelBehavior for ActiveModel {}
