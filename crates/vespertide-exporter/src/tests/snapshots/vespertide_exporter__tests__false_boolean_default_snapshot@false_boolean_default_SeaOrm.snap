#[sea_orm(table_name = "bool_defaults")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
    #[sea_orm(default_value = false)]
    pub is_deleted: bool,
}

vespera::schema_type!(Schema from Model, name = "BoolDefaultsSchema");
impl ActiveModelBehavior for ActiveModel {}
