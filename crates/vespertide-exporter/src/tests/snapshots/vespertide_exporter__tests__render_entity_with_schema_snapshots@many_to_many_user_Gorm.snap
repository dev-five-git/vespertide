package models

import (
    "github.com/google/uuid"
)

type User struct {
    ID uuid.UUID `gorm:"column:id;primaryKey;type:uuid" json:"id"`
    ArticleUsers []ArticleUser `gorm:"foreignKey:UserID" json:"-"`
