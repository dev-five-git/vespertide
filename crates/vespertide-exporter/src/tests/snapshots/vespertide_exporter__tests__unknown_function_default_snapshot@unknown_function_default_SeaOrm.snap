use sea_orm::entity::prelude::*;

#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "unknown_defaults")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
    #[sea_orm(default_value = "gen_code()")]
    pub code: String,
}

vespera::schema_type!(Schema from Model, name = "UnknownDefaultsSchema");
impl ActiveModelBehavior for ActiveModel {}
