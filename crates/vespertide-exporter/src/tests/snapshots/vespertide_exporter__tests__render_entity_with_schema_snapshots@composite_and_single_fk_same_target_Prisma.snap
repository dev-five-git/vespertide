model Src {
  id Int @id
  a_id Int
  b_id Int
  solo Int
  solo_rel Target @relation("SrcSolo", fields: [solo], references: [u], onDelete: NoAction, onUpdate: NoAction)
  target Target @relation("SrcAB", fields: [a_id, b_id], references: [a, b], onDelete: NoAction, onUpdate: NoAction)

  @@map("src")
}
