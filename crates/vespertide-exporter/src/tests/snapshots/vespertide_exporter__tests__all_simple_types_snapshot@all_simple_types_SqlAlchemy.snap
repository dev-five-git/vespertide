from __future__ import annotations

from datetime import date, datetime, time
from uuid import UUID

from sqlalchemy import BigInteger, Boolean, Date, DateTime, Float, Integer, Interval, JSON, LargeBinary, SmallInteger, String, Text, Time, Uuid
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class AllTypes(DeclarativeBase):
    __tablename__ = "all_types"

    id: Mapped[int] = mapped_column(Integer, primary_key=True)
    small: Mapped[int] = mapped_column(SmallInteger, nullable=False)
    big: Mapped[int] = mapped_column(BigInteger, nullable=False)
    real_num: Mapped[float] = mapped_column(Float, nullable=False)
    double_num: Mapped[float] = mapped_column(Float, nullable=False)
    text_col: Mapped[str] = mapped_column(Text, nullable=False)
    bool_col: Mapped[bool] = mapped_column(Boolean, nullable=False)
    date_col: Mapped[date] = mapped_column(Date, nullable=False)
    time_col: Mapped[time] = mapped_column(Time, nullable=False)
    ts_col: Mapped[datetime] = mapped_column(DateTime, nullable=False)
    tstz_col: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
    interval_col: Mapped[str] = mapped_column(Interval, nullable=False)
    bytea_col: Mapped[bytes] = mapped_column(LargeBinary, nullable=False)
    uuid_col: Mapped[UUID] = mapped_column(Uuid, nullable=False)
    json_col: Mapped[dict] = mapped_column(JSON, nullable=False)
    inet_col: Mapped[str] = mapped_column(String(255), nullable=False)
    cidr_col: Mapped[str] = mapped_column(String(255), nullable=False)
    macaddr_col: Mapped[str] = mapped_column(String(255), nullable=False)
    xml_col: Mapped[str] = mapped_column(Text, nullable=False)
