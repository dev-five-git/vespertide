use sea_orm::entity::prelude::*;

#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "products")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
    pub price: i32,
}

vespera::schema_type!(Schema from Model, name = "ProductsSchema");
impl ActiveModelBehavior for ActiveModel {}
