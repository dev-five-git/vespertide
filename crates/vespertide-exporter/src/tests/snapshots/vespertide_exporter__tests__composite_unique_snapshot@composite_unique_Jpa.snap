import jakarta.persistence.*;

@Entity
@Table(name = "composite_unique", uniqueConstraints = {
    @UniqueConstraint(name = "uq_tenant_name", columnNames = {"tenant_id", "name"})
})
public class CompositeUnique {

    @Id
    @Column(name = "id")
    private Integer id;

    @Column(name = "tenant_id", nullable = false)
    private Integer tenantId;

    @Column(name = "name", nullable = false, columnDefinition = "TEXT")
    private String name;

    protected CompositeUnique() {
    }
}
