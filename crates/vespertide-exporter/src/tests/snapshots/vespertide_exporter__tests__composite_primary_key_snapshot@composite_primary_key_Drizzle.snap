export const membership = pgTable("membership", {
  tenantId: integer("tenant_id").notNull(),
  userId: integer("user_id").notNull(),
  role: text("role").notNull(),
}, (t) => [
  primaryKey({ name: "membership_pkey", columns: [t.tenantId, t.userId] }),
]);
