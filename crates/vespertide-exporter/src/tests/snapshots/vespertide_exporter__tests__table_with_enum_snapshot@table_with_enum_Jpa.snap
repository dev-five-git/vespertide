import jakarta.persistence.*;

enum OrderStatus {
    pending,
    shipped,
    delivered;
}

@Entity
@Table(name = "orders")
public class Orders {

    @Column(name = "id", nullable = false)
    private Integer id;

    @Enumerated(EnumType.STRING)
    @Column(name = "status", nullable = false)
    private OrderStatus status;

    protected Orders() {
    }
}
