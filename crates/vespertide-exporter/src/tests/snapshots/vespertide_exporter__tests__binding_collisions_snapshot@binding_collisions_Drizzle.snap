const integer2 = customType<{ data: string }>({ dataType() { return "integer"; } });

export const userRelations = pgTable("user_relations", {
  id: integer("id").primaryKey(),
  kind: integer2("kind").notNull(),
});

export const user = pgTable("user", {
  id: integer("id").primaryKey(),
});

export const userRelations2 = relations(user, ({ one, many }) => ({
  posts: many(posts),
}));

export const sql2 = pgTable("sql", {
  id: integer("id").primaryKey(),
  amount: integer("amount").notNull(),
}, (t) => [
  check("chk_sql_amount", sql`amount > 0`),
]);

export const posts = pgTable("posts", {
  id: integer("id").primaryKey(),
  userId: integer("user_id").notNull(),
}, (t) => [
  foreignKey({ columns: [t.userId], foreignColumns: [user.id], name: "fk_posts__user_id" }),
]);

export const postsRelations = relations(posts, ({ one, many }) => ({
  user: one(user, { fields: [posts.userId], references: [user.id] }),
}));
