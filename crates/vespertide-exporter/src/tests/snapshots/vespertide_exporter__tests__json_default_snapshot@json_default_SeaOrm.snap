use sea_orm::entity::prelude::*;

#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "configs")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
    #[sea_orm(default_value = "{\"hello\": \"world\"}")]
    pub data: Json,
}

vespera::schema_type!(Schema from Model, name = "ConfigsSchema");
impl ActiveModelBehavior for ActiveModel {}
