export const user = pgTable("user", {
  id: uuid("id").primaryKey(),
});

export const userRelations = relations(user, ({ one, many }) => ({
  preferredUserProfile: many(profile, { relationName: "ProfilePreferredUser" }),
  backupUserProfile: many(profile, { relationName: "ProfileBackupUser" }),
}));
