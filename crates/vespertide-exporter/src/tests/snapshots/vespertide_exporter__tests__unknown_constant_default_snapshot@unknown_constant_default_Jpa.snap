import jakarta.persistence.*;

@Entity
@Table(name = "unknown_default")
public class UnknownDefault {

    @Id
    @Column(name = "id")
    private Integer id;

    @Column(name = "value", nullable = false, columnDefinition = "TEXT")
    private String value;

    protected UnknownDefault() {
    }
}
