export const parent = pgTable("parent", {
  id1: integer("id1").notNull(),
  id2: integer("id2").notNull(),
}, (t) => [
  primaryKey({ columns: [t.id1, t.id2] }),
]);

export const parentRelations = relations(parent, ({ one, many }) => ({
  childOne: one(childOne),
  childMany: many(childMany),
}));
