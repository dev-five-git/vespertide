from __future__ import annotations

from django.db import models


class TaskRunStatus(models.IntegerChoices):
    PENDING = 0, "Pending"
    COMPLETED = 100, "Completed"

class TaskRuns(models.Model):
    id = models.IntegerField()
    status = models.IntegerField(choices=TaskRunStatus.choices)

    class Meta:
        db_table = "task_runs"
