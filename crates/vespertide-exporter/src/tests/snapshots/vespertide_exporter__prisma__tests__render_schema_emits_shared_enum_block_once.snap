---
source: crates/vespertide-exporter/src/prisma/mod.rs
expression: schema
---
enum DocStatus {
  DRAFT @map("draft")
  PUBLISHED @map("published")
  ARCHIVED @map("archived")
}

model Documents {
  id Int
  status DocStatus
  review_status DocStatus?

  @@map("documents")
}

model ArchivedDocuments {
  id Int
  status DocStatus
  review_status DocStatus?

  @@map("archived_documents")
}
