from __future__ import annotations


from sqlmodel import Field, SQLModel


class UnknownDefault(SQLModel, table=True):
    __tablename__ = "unknown_default"

    id: int = Field(primary_key=True)
    value: str = Field(sa_column_kwargs={"server_default": text("SOME_CONSTANT")})
