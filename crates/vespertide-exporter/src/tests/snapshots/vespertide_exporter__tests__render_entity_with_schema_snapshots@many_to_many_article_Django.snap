from __future__ import annotations

from django.db import models


class Article(models.Model):
    id = models.BigIntegerField(primary_key=True)
    users = models.ManyToManyField("User", through="ArticleUser", related_name="+")

    class Meta:
        managed = False
        db_table = "article"
