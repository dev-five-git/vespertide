from __future__ import annotations

from django.db import models


class EventSeverity(models.TextChoices):
    INFO_LEVEL = "info-level", "info-level"
    WARNING_LEVEL = "warning_level", "warning_level"
    ERROR_LEVEL = "ERROR_LEVEL", "ERROR_LEVEL"
    _1CRITICAL = "1critical", "1critical"

class Events(models.Model):
    id = models.IntegerField()
    severity = models.CharField(max_length=13, choices=EventSeverity.choices)

    class Meta:
        db_table = "events"
