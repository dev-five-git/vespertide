package models

import (
    "gorm.io/datatypes"
)

type Configs struct {
    ID int32 `gorm:"column:id;primaryKey" json:"id"`
    Data datatypes.JSON `gorm:"column:data;not null;default:{"hello": "world"}" json:"data"`
}

func (Configs) TableName() string { return "configs" }
