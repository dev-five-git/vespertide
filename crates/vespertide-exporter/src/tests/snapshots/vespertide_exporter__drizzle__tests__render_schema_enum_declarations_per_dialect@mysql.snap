import { mysqlTable, int, mysqlEnum } from "drizzle-orm/mysql-core";

export const orders = mysqlTable("orders", {
  id: int("id").primaryKey(),
  st: mysqlEnum("st", ["new", "paid"]).notNull(),
});

export const tickets = mysqlTable("tickets", {
  id: int("id").primaryKey(),
  st: mysqlEnum("st", ["new", "paid"]).notNull(),
});
