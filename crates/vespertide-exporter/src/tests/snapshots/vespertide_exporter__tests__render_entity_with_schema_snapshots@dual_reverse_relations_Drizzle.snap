export const dual = pgTable("dual", {
  username: text("username").primaryKey(),
});

export const dualRelations = relations(dual, ({ one, many }) => ({
  usernameDualRel: many(dualRel, { relationName: "DualRelUsername" }),
  checkerUsernameDualRel: many(dualRel, { relationName: "DualRelCheckerUsername" }),
}));
