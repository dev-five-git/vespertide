package models

type CompositeIndex struct {
    ID int32 `gorm:"column:id;primaryKey" json:"id"`
    TenantID int32 `gorm:"column:tenant_id;not null;index:idx_tenant_name" json:"tenant_id"`
    Name string `gorm:"column:name;not null;type:text;index:idx_tenant_name" json:"name"`
}

func (CompositeIndex) TableName() string { return "composite_index" }
