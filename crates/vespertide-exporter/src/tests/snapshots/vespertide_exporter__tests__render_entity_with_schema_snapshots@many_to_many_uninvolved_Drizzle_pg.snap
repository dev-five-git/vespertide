export const user = pgTable("user", {
  id: integer("id").primaryKey(),
});

export const userRelations = relations(user, ({ one, many }) => ({
  userUserFriends: many(userFriends, { relationName: "UserFriendsUser" }),
  friendUserFriends: many(userFriends, { relationName: "UserFriendsFriend" }),
}));
