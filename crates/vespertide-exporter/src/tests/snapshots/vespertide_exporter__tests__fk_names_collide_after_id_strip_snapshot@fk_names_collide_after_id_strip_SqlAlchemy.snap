from __future__ import annotations

from typing import Optional

from sqlalchemy import ForeignKey, Integer
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class Target(DeclarativeBase):
    __tablename__ = "target"

    id: Mapped[int] = mapped_column(Integer, primary_key=True)
    alt: Mapped[int] = mapped_column(Integer, nullable=False, unique=True)

class Src(DeclarativeBase):
    __tablename__ = "src"

    pk: Mapped[int] = mapped_column(Integer, primary_key=True)
    a_id: Mapped[Optional[int]] = mapped_column(Integer, ForeignKey("target.id"), nullable=True)
    a: Mapped[Optional[int]] = mapped_column(Integer, ForeignKey("target.alt"), nullable=True)
