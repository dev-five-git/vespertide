export const user = pgTable("user", {
  id: uuid("id").primaryKey(),
});

export const userRelations = relations(user, ({ one, many }) => ({
  createdByUserSettings: one(settings, { relationName: "SettingsCreatedByUser" }),
  updatedByUserSettings: one(settings, { relationName: "SettingsUpdatedByUser" }),
}));
