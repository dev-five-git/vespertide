import jakarta.persistence.*;

@Entity
@Table(name = "user")
public class User {

    @Id
    @Column(name = "id")
    private Integer id;

    @Column(name = "tags", nullable = false, columnDefinition = "TEXT")
    private String tags;

    protected User() {
    }
}
