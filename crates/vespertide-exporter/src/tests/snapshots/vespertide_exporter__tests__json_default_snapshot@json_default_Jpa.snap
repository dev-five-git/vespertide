import jakarta.persistence.*;

@Entity
@Table(name = "configs")
public class Configs {

    @Id
    @Column(name = "id")
    private Integer id;

    @Column(name = "data", nullable = false, columnDefinition = "JSON")
    private String data;

    protected Configs() {
    }
}
