from __future__ import annotations

import enum

from sqlmodel import Field, SQLModel


class OrderStatus(str, enum.Enum):
    PENDING = "pending"
    SHIPPED = "shipped"
    DELIVERED = "delivered"

class Orders(SQLModel, table=True):
    __tablename__ = "orders"

    id: int = Field(...)
    status: OrderStatus = Field(...)
