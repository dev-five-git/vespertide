import jakarta.persistence.*;
import java.util.UUID;

@Entity
@Table(name = "session")
public class Session {

    @Id
    @Column(name = "id")
    private UUID id;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "username", nullable = false)
    private User username;

    protected Session() {
    }
}
