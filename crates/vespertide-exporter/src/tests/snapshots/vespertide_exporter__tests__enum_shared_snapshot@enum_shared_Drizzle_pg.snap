export const documentsDocStatus = pgEnum("documents_doc_status", ["draft", "published", "archived"]);

export const documents = pgTable("documents", {
  id: integer("id").notNull(),
  status: documentsDocStatus("status").notNull(),
  reviewStatus: documentsDocStatus("review_status"),
});
