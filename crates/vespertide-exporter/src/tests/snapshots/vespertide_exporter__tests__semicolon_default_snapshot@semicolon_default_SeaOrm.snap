use sea_orm::entity::prelude::*;

#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "notes")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i32,
    #[sea_orm(default_value = "a;b")]
    pub note: String,
    pub body: String,
}

vespera::schema_type!(Schema from Model, name = "NotesSchema");
impl ActiveModelBehavior for ActiveModel {}
